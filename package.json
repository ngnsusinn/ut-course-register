{
  "name": "uth-course-register",
  "version": "2.2.0",
  "description": "Open-source automated course registration & resilient schedule planning system for UTH students, built on Vercel Serverless and MongoDB Atlas.",
  "main": "api/handler.js",
  "type": "module",
  "scripts": {
    "dev": "npx --yes vercel dev",
    "deploy": "npx --yes vercel --prod",
    "build": "node esbuild.config.js",
    "check": "node --check api/handler.js api/db.js api/admin-handler.js api/sepay-webhook.js",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:offline": "node --test --test-force-exit tests/01-static-contracts.test.mjs tests/04-login-e2e.test.mjs tests/05-security.test.mjs tests/07-upstream-resilience.test.mjs",
    "test:db": "node --test --test-force-exit tests/02-db-schema-contract.test.mjs tests/03-login-path.test.mjs tests/06-migration-verification.test.mjs",
    "migrate:mongo": "node scripts/migrate-sql-to-mongo.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^1.1.1",
    "@vercel/speed-insights": "^1.0.2",
    "abort-controller": "^3.0.0",
    "https-proxy-agent": "^5.0.1",
    "mongodb": "^7.6.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "keywords": [
    "uth",
    "course-registration",
    "sepay",
    "payment",
    "vip",
    "education",
    "vietnam"
  ],
  "author": "UTH Dev Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ut-course-register"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
