{
  "name": "uth-secure-tool",
  "version": "2.2.0",
  "description": "Secure UTH Course Registration Tool with VIP features and SePay Payment (MoMo Removed)",
  "main": "api/handler.js",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "build": "node esbuild.config.js",
    "lint": "eslint api public scripts tests",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:offline": "SKIP_DB=1 node --test --test-force-exit tests/01-static-contracts.test.mjs tests/04-login-e2e.test.mjs tests/05-security.test.mjs tests/07-upstream-resilience.test.mjs",
    "test:db": "node --test --test-force-exit tests/02-db-schema-contract.test.mjs tests/03-login-path.test.mjs tests/06-migration-readiness.test.mjs",
    "db:diag": "node scripts/db-diag.mjs CURRENT-PROD 103.97.126.29 3306 \"$DB_USER\" \"$DB_PASSWORD\" \"$DB_NAME\""
  },
  "dependencies": {
    "node-fetch": "^2.6.7",
    "https-proxy-agent": "^5.0.1",
    "mysql2": "^3.6.5",
    "abort-controller": "^3.0.0",
    "@vercel/speed-insights": "^1.0.2",
    "@vercel/analytics": "^1.1.1"
  },
  "devDependencies": {
    "vercel": "^33.0.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.24.0",
    "javascript-obfuscator": "^4.1.0"
  },
  "engines": {
    "node": ">=14.x"
  },
  "keywords": [
    "uth",
    "course-registration",
    "sepay",
    "payment",
    "vip",
    "education",
    "vietnam"
  ],
  "author": "UTH Dev Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ut-course-register"
  }
}