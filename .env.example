# Database Configuration
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# SePay Configuration (Optional - can be set in admin panel)
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME

# MoMo Payment Configuration
# Get these from MoMo Business Portal: https://business.momo.vn
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_REDIRECT_URL=https://yourdomain.com/payment/return
MOMO_IPN_URL=https://yourdomain.com/api/momo-webhook

# Application Settings
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
NODE_ENV=production

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. SePay and MoMo settings can also be configured via Admin Panel
# 4. For testing, use MoMo test credentials: https://developers.momo.vn/
