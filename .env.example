# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=uth_registration

# SePay Payment Gateway
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=01006022006
SEPAY_ACCOUNT_NAME=NGUYỄN SUN SIN

# Frontend Configuration
FRONTEND_URL=*

# Timing Configuration (all times in their respective units)
SESSION_DURATION_HOURS=24
CACHE_DURATION_HOURS=24
PAYMENT_TIMEOUT_MINUTES=15
VIP_CHECK_INTERVAL_MS=7000
PAYMENT_CHECK_INTERVAL_MS=2000
DEFAULT_DELAY_MS=1000

# Class Period Configuration
# Evening periods that never conflict (comma-separated)
EVENING_PERIODS=16,17,18

# Class Status Configuration (comma-separated, Vietnamese)
# Statuses that prevent cancellation of registered class
LOCKED_STATUSES=Đã khóa lớp,Đã mở chính thức,Đang lên kế hoạch

# Statuses that prevent registration to target class
TARGET_BLOCKED_STATUSES=Đã khóa lớp,Đang lên kế hoạch
