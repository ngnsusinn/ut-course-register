# Copy to your shell before running `npm run test:db` (NOT committed — see .gitignore).
# The production MongoDB Atlas cluster (this is also the ONLY database env the deployed app
# needs — set the same variable in Vercel -> Project Settings -> Environment Variables):
export MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Optional: override the database inside the URI (default: the URI path, else uth_registration)
export MONGODB_DB=uth_registration
