{
  "version": 2,
  "builds": [
    {
      "src": "api/handler.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/handler.js"
    },
    {
      "src": "/api/handler",
      "dest": "/api/handler.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}