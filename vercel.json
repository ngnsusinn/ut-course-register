{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/handler.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sepay-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/admin-handler.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/handler",
      "dest": "/api/handler.js"
    },
    {
      "src": "/api/sepay-webhook",
      "dest": "/api/sepay-webhook.js"
    },
    {
      "src": "/api/admin-handler",
      "dest": "/api/admin-handler.js"
    },
    {
      "src": "/admin",
      "dest": "/public/admin-panel.html"
    },
    {
      "src": "/admin-panel.html",
      "dest": "/public/admin-panel.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}